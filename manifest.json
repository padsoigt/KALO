        Valeurs pour 100g — données du tableau nutritionnel
      </div>
      <!-- Ligne 1 : kcal + protéines -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
        <div class="field-group">
          <label id="lbl-frigo-kcal">Calories (kcal)</label>
          <input type="number" id="frigo-kcal" placeholder="ex: 52" min="0" style="text-align:center">
        </div>
