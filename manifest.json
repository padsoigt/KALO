      <button class="type-chip selected" onclick="selectEditMealType(this,'petit-déjeuner')">Petit-déjeuner</button>
      <button class="type-chip" onclick="selectEditMealType(this,'déjeuner')">Déjeuner</button>
      <button class="type-chip" onclick="selectEditMealType(this,'dîner')">Dîner</button>
      <button class="type-chip" onclick="selectEditMealType(this,'snack')">Snack</button>
    </div>
    <div class="ing-section-label">Ingrédients</div>
    <div class="ing-list" id="edit-ing-list"></div>
    <button class="add-row-btn" onclick="addEditIngRow()">＋ Ajouter un ingrédient</button>
    <div class="kcal-result" id="edit-kcal-result">
      <div class="kr-lbl">Estimation calorique</div>
      <div class="kr-num" id="edit-kcal-result-num">— kcal</div>
    </div>
    <div class="modal-actions" style="margin-top:10px">
      <button class="btn-cancel" onclick="closeEditMealModal()">Annuler</button>
      <button class="btn-estimate" onclick="estimateEditKcal()">Estimer les calories</button>
    </div>
    <button class="btn-save-meal" id="btn-update-meal" onclick="updateMeal()" style="display:block;margin-top:10px">Enregistrer les modifications</button>
  </div>
</div>



<!-- WEIGHT POPUP MODAL -->
<div class="popup-center-overlay" id="weight-popup-overlay">
  <div class="popup-center-box">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
      <h3 style="margin-bottom:0">⚖️ Suivi du poids</h3>
      <button onclick="closeWeightPopup()" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--text-muted)">✕</button>
    </div>

    <!-- Add new entry -->
    <div style="background:var(--bg-tertiary);border-radius:12px;padding:14px;border:1px solid var(--border);margin-bottom:14px">
      <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px">Ajouter / Modifier une entrée</div>
      <div style="display:flex;gap:8px;align-items:center">
        <input type="date" id="weight-popup-date"
          style="flex:1;padding:9px 11px;border-radius:10px;border:1.5px solid var(--border);background:var(--bg-card);color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px;outline:none">
        <input type="number" id="weight-popup-kg" placeholder="kg" min="30" max="300" step="0.1"
          style="width:80px;padding:9px 10px;border-radius:10px;border:1.5px solid var(--border);background:var(--bg-card);color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;font-weight:700;text-align:center;outline:none">
        <button onclick="addWeightFromPopup()"
          style="padding:9px 14px;border-radius:10px;border:none;background:var(--green-dark);color:white;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:700;cursor:pointer">✓ Valider</button>
      </div>
    </div>

    <!-- Entries list -->
    <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px">Historique</div>
    <div id="weight-popup-list" style="max-height:55vh;overflow-y:auto"></div>
  </div>
</div>

<!-- WATER POPUP MODAL -->
<div class="popup-center-overlay" id="water-popup-overlay">
  <div class="popup-center-box">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
      <h3 style="margin-bottom:0">💧 Hydratation du jour</h3>
      <button onclick="closeWaterPopup()" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--text-muted)">✕</button>
    </div>

    <div id="water-popup-total" style="font-size:15px;font-weight:700;color:#2980b9;margin-bottom:12px">0 ml / 2000 ml</div>

    <!-- Add new entry -->
    <div style="background:var(--bg-tertiary);border-radius:12px;padding:13px;border:1px solid var(--border);margin-bottom:14px">
      <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px">Ajouter une prise</div>
      <div style="display:flex;gap:7px;margin-bottom:8px">
        <input type="text" id="water-popup-label" placeholder="Eau, café, thé..." maxlength="30"
          style="flex:1;padding:8px 10px;border-radius:9px;border:1.5px solid var(--border);background:var(--bg-card);color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px;outline:none">
      </div>
      <div style="display:flex;gap:7px;align-items:center">
        <input type="number" id="water-popup-input" placeholder="Quantité" min="1" max="5000"
          style="flex:1;padding:8px 10px;border-radius:9px;border:1.5px solid var(--border);background:var(--bg-card);color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;font-weight:700;text-align:center;outline:none">
        <select id="water-popup-unit"
          style="padding:8px 8px;border-radius:9px;border:1.5px solid var(--border);background:var(--bg-card);color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:700;outline:none">
          <option value="ml">ml</option>
          <option value="cl">cl</option>
          <option value="L">L</option>
        </select>
        <button onclick="addWaterFromPopup()"
          style="padding:8px 14px;border-radius:9px;border:none;background:#2980b9;color:white;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:700;cursor:pointer">+ Ajouter</button>
      </div>
      <!-- Quick adds in popup -->
      <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap">
        <button onclick="addWaterQuick(150,'ml')" style="padding:5px 10px;border-radius:20px;border:1.5px solid #2980b9;background:none;color:#2980b9;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:700;cursor:pointer">+150ml</button>
        <button onclick="addWaterQuick(250,'ml')" style="padding:5px 10px;border-radius:20px;border:1.5px solid #2980b9;background:none;color:#2980b9;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:700;cursor:pointer">+250ml</button>
        <button onclick="addWaterQuick(500,'ml')" style="padding:5px 10px;border-radius:20px;border:1.5px solid #2980b9;background:none;color:#2980b9;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:700;cursor:pointer">+500ml</button>
        <button onclick="addWaterQuick(1,'L')" style="padding:5px 10px;border-radius:20px;border:none;background:#2980b9;color:white;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:700;cursor:pointer">+1L</button>
      </div>
    </div>

    <!-- Entries list -->
    <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px">Entrées d'aujourd'hui</div>
    <div id="water-popup-list" style="max-height:40vh;overflow-y:auto"></div>
  </div>
</div>

<!-- TOAST NOTIFICATION -->
<div class="toast" id="toast">
  <span id="toast-msg">⚖️ Ton poids a changé. Veux-tu recalculer ton TDEE ?</span>
  <div class="toast-actions">
    <button class="toast-btn primary" id="toast-primary-btn">Recalculer</button>
    <button class="toast-btn secondary" onclick="hideToast()">Plus tard</button>
  </div>
</div>


<!-- Scripts — chargés dans l'ordre des dépendances -->
<script src="js/database.js"></script>
<script src="js/nutrition.js"></script>
<script src="js/utils.js"></script>
<script src="pages/frigo.js"></script>
<script src="pages/agenda.js"></script>
<script src="pages/onboarding.js"></script>
<script src="pages/accueil.js"></script>
<script src="pages/profil.js"></script>
<script src="pages/export.js"></script>
<script src="js/app.js"></script>

</body>
</html>