<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>KALO - Coach nutrition intelligent</title>
<link rel="icon" type="image/png" href="https://raw.githubusercontent.com/padsoigt/KALO/main/picto.png">
<link rel="shortcut icon" href="https://raw.githubusercontent.com/padsoigt/KALO/main/picto.png">
<link rel="apple-touch-icon" href="https://raw.githubusercontent.com/padsoigt/KALO/main/picto.png">
<meta name="theme-color" content="#4A9A49">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="KALO">
<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/main.css">
</head>

</head>


</head>
<body>
<!-- ONBOARDING — désactivé, masqué -->
<div id="onboarding-screen" style="display:none">
</div>

<div class="app">
  <div class="header">
    <div class="header-logo">
      <img src="https://raw.githubusercontent.com/padsoigt/KALO/main/picto.png" style="width:36px;height:36px;border-radius:10px;object-fit:cover" alt="KALO">
      <div class="header-sub">
        <h1 id="header-logo-text">KALO</h1>
        <span>Coach nutrition intelligent</span>
      </div>
    </div>
  </div>

  <div class="content">

    <!-- FRIGO -->
    <div class="screen" id="screen-frigo">
      <div class="frigo-header">
        <div><h2>Mon Frigo</h2><div class="count" id="frigo-count">0 ingrédients actifs</div></div>
        <button class="btn-add-green" id="frigo-add-btn">＋ Ajouter</button>
      </div>
      <div class="import-export-bar">
        <button class="ie-btn" onclick="exportFrigo()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Exporter mon frigo
        </button>
        <button class="ie-btn" onclick="triggerImportFrigo()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Importer mon frigo
        </button>
        <input type="file" id="import-frigo-file" accept=".json" style="display:none" onchange="importFrigo(this)">
      </div>
      <div class="frigo-search">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" placeholder="Rechercher un ingrédient..." id="frigo-search-input">
      </div>
      <div id="frigo-list"></div>
      <div class="archive-section" style="margin-bottom:20px">
        <button class="archive-toggle" id="archive-toggle-btn">
          🗃️ Archive
          <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="archive-body" id="archive-body"></div>
      </div>
    </div>

    <!-- AGENDA -->
    <div class="screen" id="screen-agenda">
      <div class="agenda-top">
        <div><h2>Agenda</h2><div style="font-size:12px;color:var(--text-muted)" id="agenda-month-lbl">Mai 2026</div></div>
        <button class="btn-add-green" id="agenda-add-btn" onclick="openMealModal()">＋ Ajouter</button>
      </div>
      <div class="import-export-bar">
        <button class="ie-btn" onclick="exportMeals()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Exporter tous les repas
        </button>
        <button class="ie-btn" onclick="triggerImportMeals()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Importer des repas
        </button>
        <input type="file" id="import-meals-file" accept=".json" style="display:none" onchange="importMeals(this)">
      </div>
      <div class="calendar-wrap">
        <div class="cal-header">
          <button class="cal-nav-btn" onclick="calPrev()">‹</button>
          <span id="cal-month-title">Mai 2026</span>
          <button class="cal-nav-btn" onclick="calNext()">›</button>
        </div>
        <div class="cal-grid" id="cal-grid"></div>
      </div>
      <div class="week-nav" id="week-nav"></div>
      <div id="day-content"></div>
    </div>

    <!-- ANALYSE -->
    <!-- PROFIL -->
    <div class="screen" id="screen-profil">
      <div style="padding:20px 20px 0;display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
        <div>
          <h2 style="font-family:'DM Serif Display',serif;font-size:26px">Mon profil</h2>
          <p style="font-size:12px;color:var(--text-muted)">Paramètres & objectifs</p>
        </div>
      </div>
      <div style="padding:0 20px">

        <!-- Mode d'affichage -->
        <div class="profile-card" style="margin-bottom:14px">
          <h3>🎨 Mode d'affichage</h3>
          <div style="display:flex;flex-direction:column;gap:8px">
            <label style="display:flex;align-items:center;gap:12px;padding:11px 14px;border-radius:12px;border:1.5px solid var(--border);cursor:pointer;transition:all .2s" id="mode-opt-light" onclick="setDisplayMode('light')">
              <span style="font-size:18px">☀️</span>
              <div style="flex:1"><div style="font-size:14px;font-weight:600;color:var(--text)">Mode clair</div><div style="font-size:12px;color:var(--text-muted)">Fond blanc, touches vertes</div></div>
              <div id="mode-check-light" style="width:18px;height:18px;border-radius:50%;background:var(--green-dark);display:flex;align-items:center;justify-content:center"><svg viewBox="0 0 12 12" width="12" height="12"><polyline points="2,6 5,9 10,3" fill="none" stroke="white" stroke-width="2" stroke-linecap="round"/></svg></div>
            </label>
            <label style="display:flex;align-items:center;gap:12px;padding:11px 14px;border-radius:12px;border:1.5px solid var(--border);cursor:pointer;transition:all .2s" id="mode-opt-dark" onclick="setDisplayMode('dark')">
              <span style="font-size:18px">🌙</span>
              <div style="flex:1"><div style="font-size:14px;font-weight:600;color:var(--text)">Mode sombre</div><div style="font-size:12px;color:var(--text-muted)">Fond noir, touches vertes</div></div>
              <div id="mode-check-dark" style="width:18px;height:18px;border-radius:50%;background:var(--border);display:flex;align-items:center;justify-content:center;opacity:.3"></div>
            </label>
            <label style="display:flex;align-items:center;gap:12px;padding:11px 14px;border-radius:12px;border:1.5px solid var(--border);cursor:pointer;transition:all .2s" id="mode-opt-mao" onclick="setDisplayMode('mao')">
              <span style="font-size:18px">🚩</span>
              <div style="flex:1"><div style="font-size:14px;font-weight:600;color:var(--text)">Communisme de Mao</div><div style="font-size:12px;color:var(--text-muted)">Fond blanc, touches rouges révolutionnaires</div></div>
              <div id="mode-check-mao" style="width:18px;height:18px;border-radius:50%;background:var(--border);display:flex;align-items:center;justify-content:center;opacity:.3"></div>
            </label>
          </div>
        </div>

        <!-- Infos personnelles -->
        <div class="profile-card">
          <h3>👤 Informations personnelles</h3>
          <input type="text" id="profile-name" class="profile-name-input" placeholder="Votre prénom">
          <div class="profile-fields">
            <div class="field-group"><label>Âge</label><input type="number" id="profile-age" placeholder="26" min="10" max="99"></div>
            <div class="field-group"><label>Poids (kg)</label><input type="number" id="profile-weight" placeholder="70" min="30" max="300" step="0.1"></div>
            <div class="field-group"><label>Taille (cm)</label><input type="number" id="profile-height" placeholder="170" min="100" max="250"></div>
          </div>
          <div class="field-group" style="margin-bottom:12px">
            <label>Objectif poids (kg)</label>
            <input type="number" id="profile-target-weight" placeholder="65" min="30" max="300" step="0.1">
          </div>
          <!-- Gender -->
          <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px">Genre</div>
          <div class="gender-toggle">
            <button id="ob-btn-homme" class="gender-btn active" onclick="obSetGender('homme')">♂ Homme</button>
            <button id="ob-btn-femme" class="gender-btn" onclick="obSetGender('femme')">♀ Femme</button>
          </div>
          <!-- Activity -->
          <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px">Niveau d'activité</div>
          <div class="activity-options">
            <div class="activity-opt selected" onclick="selectActivity(this,'sedentaire')">
              <div><div class="oname">🪑 Sédentaire</div><div class="odesc">Peu ou pas d'exercice</div></div>
            </div>
            <div class="activity-opt" onclick="selectActivity(this,'leger')">
              <div><div class="oname">🚶 Léger</div><div class="odesc">1-3 fois/semaine</div></div>
            </div>
            <div class="activity-opt" onclick="selectActivity(this,'modere')">
              <div><div class="oname">🏃 Modéré</div><div class="odesc">3-5 fois/semaine</div></div>
            </div>
            <div class="activity-opt" onclick="selectActivity(this,'actif')">
              <div><div class="oname">💪 Très actif</div><div class="odesc">6-7 fois/semaine</div></div>
            </div>
          </div>
          <!-- Budget calorique personnalisé -->
          <div style="background:var(--bg-tertiary);border-radius:12px;padding:13px 15px;margin-bottom:14px;border:1.5px solid var(--border)">
            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px">🎯 Budget calorique personnalisé</div>
            <div style="font-size:12px;color:var(--text-muted);margin-bottom:10px;line-height:1.5">Laissez vide pour utiliser le calcul automatique (TDEE − déficit). Renseignez une valeur pour forcer un budget précis.</div>
            <div style="display:flex;gap:8px;align-items:center">
              <input type="number" id="profile-manual-budget" placeholder="ex : 1800" min="800" max="5000" step="50"
                style="flex:1;padding:10px 12px;border-radius:10px;border:1.5px solid var(--border);background:var(--bg-card);color:var(--text);font-family:'DM Sans',sans-serif;font-size:16px;font-weight:700;text-align:center;outline:none"
                oninput="document.getElementById('manual-budget-preview').textContent=this.value?this.value+' kcal/jour':'— (calcul auto)'">
              <span style="font-size:13px;color:var(--text-muted)">kcal/j</span>
            </div>
            <div id="manual-budget-preview" style="font-size:12px;color:var(--green-glow);font-weight:600;margin-top:6px;text-align:center">— (calcul auto)</div>
          </div>

          <button class="btn-save" onclick="saveProfile()">💾 Sauvegarder</button>
        </div>

        <!-- Export complet -->
        <div class="profile-card" style="margin-bottom:14px">
          <h3>📤 Exporter mes données</h3>
          <p style="font-size:12px;color:var(--text-muted);margin-bottom:12px;line-height:1.5">Exportez l'intégralité de vos repas, ingrédients, macros, protéines, lipides, glucides, historique de poids et de pas.</p>
          <div style="display:flex;flex-direction:column;gap:8px">
            <button onclick="exportCompletData()" style="display:flex;align-items:center;gap:8px;padding:12px 14px;border-radius:11px;border:1.5px solid var(--green-dark);background:var(--green-dark);color:white;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:700;cursor:pointer;width:100%;justify-content:center">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Export complet (JSON) — Repas + Ingrédients + Poids + Pas
            </button>
            <button onclick="exportMacrosCSV()" style="display:flex;align-items:center;gap:8px;padding:12px 14px;border-radius:11px;border:1.5px solid var(--border);background:var(--bg-tertiary);color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;cursor:pointer;width:100%;justify-content:center">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Export CSV — Repas + Macros + Ingrédients détaillés
            </button>
            <button onclick="exportMeals()" style="display:flex;align-items:center;gap:8px;padding:11px 14px;border-radius:11px;border:1.5px solid var(--border);background:none;color:var(--text-secondary);font-family:'DM Sans',sans-serif;font-size:12px;font-weight:600;cursor:pointer;width:100%;justify-content:center">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Export repas uniquement (JSON)
            </button>
          </div>
        </div>

        <!-- Objectif pas -->
        <div class="card" style="margin-top:0">
          <h4>👟 Objectif de pas</h4>
          <div style="display:flex;gap:8px;align-items:center">
            <input type="number" id="steps-goal-input" placeholder="10000" min="1000" max="50000" step="500"
              style="flex:1;padding:10px 12px;border-radius:10px;border:1.5px solid var(--border);background:var(--bg-tertiary);color:var(--text);font-family:'DM Sans',sans-serif;font-size:16px;font-weight:700;text-align:center;outline:none">
            <span style="font-size:13px;color:var(--text-muted)">pas/jour</span>
            <button onclick="saveStepsGoal()" style="padding:10px 14px;border-radius:10px;border:none;background:var(--green-dark);color:white;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:700;cursor:pointer">OK</button>
          </div>
        </div>

        <!-- Objectif eau -->
        <div class="card" style="margin-top:0">
          <h4>💧 Objectif hydratation</h4>
          <div style="display:flex;gap:8px;align-items:center">
            <input type="number" id="water-goal-input" min="500" max="6000" step="100" placeholder="2000"
              style="flex:1;padding:10px 12px;border-radius:10px;border:1.5px solid var(--border);background:var(--bg-tertiary);color:var(--text);font-family:'DM Sans',sans-serif;font-size:16px;font-weight:700;text-align:center;outline:none">
            <span style="font-size:13px;color:var(--text-muted)">ml/jour</span>
            <button onclick="saveWaterGoal()" style="padding:10px 14px;border-radius:10px;border:none;background:#2980b9;color:white;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:700;cursor:pointer">OK</button>
          </div>
        </div>



      </div>
    </div>

    <div class="screen active" id="screen-analyse">
      <div class="analyse-page">

        <!-- HEADER -->
        <div style="padding:18px 20px 0;display:flex;justify-content:space-between;align-items:flex-start">
          <div>
            <h2 style="font-family:'DM Serif Display',serif;font-size:26px;line-height:1.1">Bonjour <span id="home-name" style="color:var(--green-glow)">👋</span></h2>
            <p style="font-size:12px;color:var(--text-muted);margin-top:2px" id="home-date">Aujourd'hui</p>
            <p style="font-size:12px;color:var(--text-muted);margin-top:1px" id="home-imc-display"></p>
          </div>
          <button onclick="showScreen('profil')" style="width:38px;height:38px;border-radius:50%;border:1.5px solid var(--border);background:var(--bg-card);display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:var(--shadow)">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" width="18" height="18"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </button>
        </div>

        <!-- CALORIE RING -->
        <div style="padding:16px 20px 0">
          <div style="background:var(--bg-card);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow);border:1px solid var(--border)">
            <div style="display:flex;align-items:center;gap:20px">
              <!-- Ring SVG -->
              <div style="position:relative;flex-shrink:0;width:110px;height:110px">
                <svg viewBox="0 0 110 110" width="110" height="110">
                  <!-- Background ring -->
                  <circle cx="55" cy="55" r="46" fill="none" stroke="var(--border)" stroke-width="10"/>
                  <!-- Progress ring -->
                  <circle cx="55" cy="55" r="46" fill="none" stroke="var(--green-glow)" stroke-width="10"
                    stroke-linecap="round" stroke-dasharray="289" stroke-dashoffset="289"
                    id="calorie-ring" style="transition:stroke-dashoffset .8s cubic-bezier(.4,0,.2,1);transform:rotate(-90deg);transform-origin:55px 55px"/>
                </svg>
                <!-- Center text -->
                <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center">
                  <span id="ring-remaining" style="font-size:22px;font-weight:800;color:var(--text);line-height:1">0</span>
                  <span style="font-size:9px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px">restantes</span>
                </div>
              </div>
              <!-- Right stats -->
              <div style="flex:1;display:flex;flex-direction:column;gap:10px">
                <div style="display:flex;justify-content:space-between;align-items:center">
                  <div>
                    <div style="font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px">Consommées</div>
                    <div id="ring-consumed" style="font-size:18px;font-weight:800;color:var(--orange)">0 kcal</div>
                  </div>
                  <div style="text-align:right">
                    <div style="font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px">Objectif</div>
                    <div id="ring-budget" style="font-size:18px;font-weight:800;color:var(--text)">0 kcal</div>
                  </div>
                </div>
                <!-- Burned (BMR) -->
                <div style="background:var(--bg-tertiary);border-radius:10px;padding:8px 11px;border:1px solid var(--border)">
                  <div style="font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:2px">Brûlées (métabolisme)</div>
                  <div style="display:flex;align-items:center;gap:6px">
                    <span style="font-size:16px">🔥</span>
                    <span id="ring-burned" style="font-size:16px;font-weight:800;color:var(--green-glow)">0 kcal</span>
                    <span style="font-size:11px;color:var(--text-muted)" id="ring-steps-bonus"></span>
                  </div>
                </div>
              </div>
            </div>
            <!-- Macro bars -->
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:14px">
              <div id="macro-card-p" style="background:var(--bg-tertiary);border-radius:10px;padding:9px 10px;border:1px solid var(--border)">
                <div style="font-size:10px;font-weight:700;color:#e74c3c;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px">Protéines</div>
                <div style="font-size:15px;font-weight:800;color:var(--text)" id="macro-p-val">0g</div>
                <div style="height:4px;background:var(--border);border-radius:3px;overflow:hidden;margin-top:5px">
                  <div id="macro-p-bar" style="height:100%;background:#e74c3c;border-radius:3px;width:0%;transition:width .6s"></div>
                </div>
              </div>
              <div id="macro-card-g" style="background:var(--bg-tertiary);border-radius:10px;padding:9px 10px;border:1px solid var(--border)">
                <div style="font-size:10px;font-weight:700;color:#f39c12;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px">Glucides</div>
                <div style="font-size:15px;font-weight:800;color:var(--text)" id="macro-g-val">0g</div>
                <div style="height:4px;background:var(--border);border-radius:3px;overflow:hidden;margin-top:5px">
                  <div id="macro-g-bar" style="height:100%;background:#f39c12;border-radius:3px;width:0%;transition:width .6s"></div>
                </div>
              </div>
              <div id="macro-card-l" style="background:var(--bg-tertiary);border-radius:10px;padding:9px 10px;border:1px solid var(--border)">
                <div style="font-size:10px;font-weight:700;color:#2980b9;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px">Lipides</div>
                <div style="font-size:15px;font-weight:800;color:var(--text)" id="macro-l-val">0g</div>
                <div style="height:4px;background:var(--border);border-radius:3px;overflow:hidden;margin-top:5px">
                  <div id="macro-l-bar" style="height:100%;background:#2980b9;border-radius:3px;width:0%;transition:width .6s"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- WEIGHT CHART -->
        <div style="padding:14px 20px 0">
          <div class="weight-chart-wrap">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
              <h4 style="margin-bottom:0">⚖️ Poids & IMC</h4>
              <button onclick="openWeightPopup()" style="display:flex;align-items:center;gap:5px;padding:6px 11px;border-radius:9px;border:1.5px solid var(--border);background:none;color:var(--text-secondary);font-family:'DM Sans',sans-serif;font-size:12px;font-weight:600;cursor:pointer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                ✏️ Gérer
              </button>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
              <div id="weight-latest-display" style="font-size:20px;font-weight:800;color:var(--green-glow)">— kg</div>
              <div id="weight-imc-display" style="font-size:13px;color:var(--text-muted);font-weight:600"></div>
            </div>
            <svg class="weight-chart-svg" id="weight-chart-svg" viewBox="0 0 360 180" style="height:180px"></svg>
            <div class="weight-stats" id="weight-stats"></div>
          </div>
        </div>

        <!-- STEPS TRACKER -->
        <div style="padding:0 20px">
          <div class="card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
              <h4 style="margin-bottom:0">👟 Pas du jour</h4>
              <button onclick="openStepsInput()" style="display:flex;align-items:center;gap:5px;padding:6px 11px;border-radius:9px;border:1.5px solid var(--border);background:none;color:var(--text-secondary);font-family:'DM Sans',sans-serif;font-size:12px;font-weight:600;cursor:pointer">
                + Saisir
              </button>
            </div>
            <div style="display:flex;align-items:baseline;gap:6px;margin-bottom:6px">
              <span id="steps-count" style="font-size:26px;font-weight:800;color:var(--text)">0</span>
              <span style="font-size:13px;color:var(--text-muted)">/ <span id="steps-goal-lbl">10 000</span> pas</span>
              <span id="steps-pct-lbl" style="font-size:12px;font-weight:700;color:var(--green-glow);margin-left:auto">0%</span>
            </div>
            <div style="height:8px;background:var(--border);border-radius:5px;overflow:hidden;margin-bottom:8px">
              <div id="steps-bar" style="height:100%;background:linear-gradient(90deg,var(--green-dark),var(--green-glow));border-radius:5px;width:0%;transition:width .7s cubic-bezier(.4,0,.2,1)"></div>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center">
              <span id="steps-kcal-lbl" style="font-size:12px;color:var(--text-muted)">≈ 0 kcal brûlées</span>
              <span id="steps-dist-lbl" style="font-size:12px;color:var(--text-muted)">≈ 0 km</span>
            </div>
            <!-- Quick steps input (inline) -->
            <div id="steps-input-wrap" style="display:none;margin-top:10px;display:none">
              <div style="display:flex;gap:7px;align-items:center;margin-top:10px">
                <input type="number" id="steps-input" placeholder="ex: 8500" min="0" max="100000"
                  style="flex:1;padding:10px 12px;border-radius:10px;border:1.5px solid var(--border);background:var(--bg-tertiary);color:var(--text);font-family:'DM Sans',sans-serif;font-size:16px;font-weight:700;text-align:center;outline:none">
                <button onclick="saveSteps()" style="padding:10px 16px;border-radius:10px;border:none;background:var(--green-dark);color:white;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:700;cursor:pointer">✓</button>
                <button onclick="closeStepsInput()" style="padding:10px 12px;border-radius:10px;border:1.5px solid var(--border);background:none;color:var(--text-muted);font-family:'DM Sans',sans-serif;font-size:13px;cursor:pointer">✕</button>
              </div>
            </div>
            <!-- Statistiques multi-périodes -->
            <div style="margin-top:14px;border-top:1px solid var(--border);padding-top:12px">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
                <span style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px">Statistiques</span>
                <div style="display:flex;gap:5px">
                  <button id="sbtn-week" class="period-btn active" onclick="setStepsPeriod(this,'week')" style="padding:4px 9px;font-size:11px">7j</button>
                  <button id="sbtn-month" class="period-btn" onclick="setStepsPeriod(this,'month')" style="padding:4px 9px;font-size:11px">1 mois</button>
                  <button id="sbtn-3month" class="period-btn" onclick="setStepsPeriod(this,'3month')" style="padding:4px 9px;font-size:11px">3 mois</button>
                </div>
              </div>
              <div id="steps-stats-wrap"></div>
            </div>
          </div>
        </div>

        <!-- WATER WIDGET -->
        <div style="padding:0 20px">
          <div class="card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
              <h4 style="margin-bottom:0">💧 Hydratation du jour</h4>
              <button onclick="openWaterPopup()" style="display:flex;align-items:center;gap:5px;padding:6px 12px;border-radius:9px;border:1.5px solid var(--border);background:none;color:var(--text-secondary);font-family:'DM Sans',sans-serif;font-size:12px;font-weight:600;cursor:pointer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                ✏️ Gérer
              </button>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px">
              <div>
                <span id="water-amount-lbl" style="font-size:22px;font-weight:800;color:#2980b9">0 ml</span>
                <span style="font-size:13px;color:var(--text-muted);margin-left:5px">/ <span id="water-goal-lbl">2000</span> ml</span>
              </div>
              <span id="water-pct-lbl" style="font-size:13px;font-weight:700;color:#2980b9">0%</span>
            </div>
            <div style="height:10px;background:var(--border);border-radius:6px;overflow:hidden;margin-bottom:10px">
              <div id="water-prog-fill" style="height:100%;background:linear-gradient(90deg,#2980b9,#5dade2);border-radius:6px;width:0%;transition:width .7s cubic-bezier(.4,0,.2,1)"></div>
            </div>
            <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:9px">
              <button onclick="addWaterQuick(150,'ml')" style="padding:5px 11px;border-radius:20px;border:1.5px solid #2980b9;background:none;color:#2980b9;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:700;cursor:pointer">+150ml</button>
              <button onclick="addWaterQuick(250,'ml')" style="padding:5px 11px;border-radius:20px;border:1.5px solid #2980b9;background:none;color:#2980b9;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:700;cursor:pointer">+250ml</button>
              <button onclick="addWaterQuick(500,'ml')" style="padding:5px 11px;border-radius:20px;border:1.5px solid #2980b9;background:none;color:#2980b9;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:700;cursor:pointer">+500ml</button>
              <button onclick="addWaterQuick(1,'L')" style="padding:5px 11px;border-radius:20px;border:none;background:#2980b9;color:white;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:700;cursor:pointer">+1L</button>
            </div>
            <div style="display:flex;gap:7px;align-items:center">
              <input type="number" id="water-custom-input" placeholder="ex: 330" min="1" max="5000"
                style="flex:1;padding:9px 12px;border-radius:var(--radius-xs);border:1.5px solid var(--border);background:var(--bg-tertiary);color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;font-weight:600;outline:none;text-align:center">
              <select id="water-custom-unit" style="padding:9px 8px;border-radius:var(--radius-xs);border:1.5px solid var(--border);background:var(--bg-tertiary);color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:700;outline:none">
                <option value="ml">ml</option><option value="cl">cl</option><option value="L">L</option>
              </select>
              <button onclick="addWaterCustom()" style="padding:9px 14px;border-radius:var(--radius-xs);border:none;background:#2980b9;color:white;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:700;cursor:pointer">+ Ajouter</button>

            </div>
          </div>
        </div>

        <!-- ANALYTICS SECTION -->
        <div style="padding:0 20px 20px">
          <div class="card" style="padding-bottom:14px">

            <!-- Period selector -->
            <div style="display:flex;gap:6px;margin-bottom:14px">
              <button class="period-btn active" id="hbtn-week"   onclick="setHomePeriod(this,'week')">7 jours</button>
              <button class="period-btn"        id="hbtn-month"  onclick="setHomePeriod(this,'month')">1 mois</button>
              <button class="period-btn"        id="hbtn-3month" onclick="setHomePeriod(this,'3month')">3 mois</button>
            </div>

            <!-- Summary cards -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px">
              <div style="background:var(--bg-tertiary);border-radius:11px;padding:11px 12px;border:1px solid var(--border)">
                <div style="font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px">Moyenne / jour</div>
                <div style="font-size:20px;font-weight:800;color:var(--orange)" id="home-avg-kcal">— kcal</div>
                <div style="font-size:11px;color:var(--text-muted);margin-top:2px">Objectif <span id="home-budget-lbl">—</span> kcal</div>
              </div>
              <div style="background:var(--bg-tertiary);border-radius:11px;padding:11px 12px;border:1px solid var(--border)">
                <div style="font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px">Déficit total</div>
                <div style="font-size:20px;font-weight:800;color:var(--green-glow)" id="home-deficit-total">— kcal</div>
                <div style="font-size:11px;color:var(--text-muted);margin-top:2px" id="home-period-lbl">sur 7 jours</div>
              </div>
            </div>

            <!-- Bar chart + day details -->
            <div id="home-bar-chart-wrap"></div>

          </div>
        </div>

      </div>
    </div>

  <nav class="bottom-nav">
