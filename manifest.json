        <div class="field-group">
          <label id="lbl-frigo-lip">Lipides (g)</label>
          <input type="number" id="frigo-lip" placeholder="ex: 1.6" min="0" style="text-align:center">
        </div>
        <div class="field-group">
          <label id="lbl-frigo-fib">Fibres (g)</label>
          <input type="number" id="frigo-fib" placeholder="ex: 0" min="0" style="text-align:center">
        </div>
      </div>
    </div>

    <div class="modal-actions">
      <button class="btn-cancel" onclick="closeFrigoModal()">Annuler</button>
      <button class="btn-confirm" onclick="addIngredient()">Ajouter</button>
    </div>
  </div>
</div>

