          <button id="nutr-ref-100g" class="nutr-ref-btn active" onclick="setNutrRef('100g')">/ 100g</button>
          <button id="nutr-ref-unit" class="nutr-ref-btn" onclick="setNutrRef('unit')">/ unité</button>
        </div>
      </div>
