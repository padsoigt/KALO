      <button type="button" class="cat-chip" onclick="selectCat(this,'laitiers')">Laitiers</button>
      <button type="button" class="cat-chip" onclick="selectCat(this,'fruits')">Fruits</button>
      <button type="button" class="cat-chip" onclick="selectCat(this,'condiments')">Condiments</button>
